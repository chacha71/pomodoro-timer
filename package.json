{
  "name": "pomodoro-timer",
  "version": "1.0.0",
  "description": "🍅 番茄钟 - 桌面番茄计时器",
  "author": "Pomodoro Timer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.pomodoro.timer",
    "productName": "番茄钟",
    "directories": { "output": "dist" },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.ico"
    ],
    "icon": "build/icon.ico",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "target": ["portable"],
      "signAndEditExecutable": false,
      "artifactName": "番茄钟-${version}.exe"
    },
    "portable": {
      "artifactName": "番茄钟-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  }
}
